{
  "name": "puty",
  "version": "0.1.2",
  "description": "A tooling function to test javascript functions and classes.",
  "main": "src/index.js",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./vitest": "./src/vitest-plugin.js",
    "./setup": "./src/setup.js"
  },
  "files": [
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuusoft-org/puty.git"
  },
  "license": "MIT",
  "dependencies": {
    "js-yaml": "~4.1.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest run",
    "lint": "bunx prettier src tests -c",
    "lint:fix": "bunx prettier src tests -w",
    "build": "bun run esbuild.js"
  },
  "devDependencies": {
    "vitest": "^3.2.1"
  },
  "peerDependencies": {
    "vitest": ">=1.0.0"
  }
}
